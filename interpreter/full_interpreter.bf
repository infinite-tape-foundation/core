/*
 * The Self-Referential Loop: Full BF-in-BF Interpreter
 * 
 * Memory Map:
 * [0] : Instruction Pointer (IP)
 * [1] : Current Opcode Register
 * [2] : Virtual Data Pointer (VDP) - Relative offset to Guest Tape Start
 * [3] : Temp / Scratchpad A / Nesting Counter
 * [4] : Temp / Scratchpad B / Search State
 * [5...] : Guest Program and Workspace (SourceBase = 5)
 */

/* Initialization: Set VDP=0, IP=0 */
[ - ]

/* MAIN EXECUTION LOOP */
[
    /* --- STEP 1: INDEXED FETCH ---
     * Move from IP[0] to (SourceBase[5] + IP[0]) and copy value to Opcode[1]
     */
    > > > [ - > + < ] < < <
    > > > > >
    < < < < [ - > + < ]
    [ - < < < < + > ]
    < < < < <

    /* --- STEP 2: DISPATCHER ---
     * ASCII values: '>' : 62, '<' : 60, '+' : 43, '-' : 45, '.' : 46, ',' : 44, '[' : 91, ']' : 93
     */

    /* Logic for '+': (Opcode == 43) */
    > 
    [ - > > + < < ]
    > > 
    +++++++ [ > ++++++ < - ]
    < 
    [ - > + < ]
    > 
    [ - ] < 
    < < 
    [ - > + < ]
    > > 
    > > > 
    < [ - > + < ]
    + 
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <

    /* Logic for '-': (Opcode == 45) */
    > 
    [ - > > + < < ] 
    > > 
    +++++++ [ > ++++++ < - ] 
    < 
    -- 
    [ - > + < ] 
    > 
    [ - ] < 
    < < 
    [ - > + < ]
    > > > > > 
    < [ - > + < ]
    - 
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <

    /* Logic for '>': (Opcode == 62) */
    > 
    [ - > > + < < ] 
    > > 
    +++++++ [ > ++++++ < - ] 
    < 
    +++++++++++++++++++++++++++
    [ - > + < ]
    > 
    [ - ] < 
    < < 
    + 
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <

    /* Logic for '<': (Opcode == 60) */
    > 
    [ - > > + < < ] 
    > > 
    +++++++ [ > ++++++ < - ] 
    < 
    ++++++++++++++++++++++
    [ - > + < ]
    > 
    [ - ] < 
    < < 
    - 
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <

    /* Logic for '.': (Opcode == 46) */
    > 
    [ - > > + < < ] 
    > > 
    +++++++ [ > ++++++ < - ] 
    < 
    +++ 
    [ - > + < ]
    > 
    [ - ] < 
    < < 
    [ - > + < ]
    > > 
    > > > 
    < [ - > + < ]
    . 
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <

    /* Logic for ',': (Opcode == 44) */
    > 
    [ - > > + < < ] 
    > > 
    +++++++ [ > ++++++ < - ] 
    < 
    + 
    [ - > + < ]
    > 
    [ - ] < 
    < < 
    [ - > + < ]
    > > 
    > > > 
    < [ - > + < ]
    , 
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <

    /* Logic for '[': (Opcode == 91) */
    > 
    [ - > > + < < ] 
    > > 
    +++++++ [ > ++++++ < - ] 
    < 
    ++++++++++++++++++++++++++++++
    [ - > + < ]
    > 
    [ - ] < 
    /* Check if GuestTape[VDP] is zero */
    < < 
    [ - > + < ]
    > > 
    > > > 
    < [ - > + < ]
    [ 
        /* If NOT zero, just move to IP increment */
        < < < < < < < <
        > > > > >
        < [ - < + > ]
        < < < <
    ] 
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <
    [
        /* If ZERO: execute Forward Jump logic */
        > > > + < < <
        + 
        > > > [
            < < < 
            > > > [ - > + < ] < < < 
            > > > > > 
            < < < < [ - > + < ] 
            [ - < < < < + > ] 
            < < < < <
            > 
            [ - > > + < < ]
            > > 
            +++++++ [ > ++++++ < - ]
            < 
            ++++++++++++++++++++++++++++++
            [ - > + < ]
            > 
            [ - > + < ]
            > 
            [ - > > + < < ]
            < < [ - ]
            > 
            [ - > > + < < ]
            > > 
            +++++++ [ > ++++++ < - ]
            < 
            ++++++++++++++++++++++++++++++
            ++ 
            [ - > + < ]
            > 
            [ - > + < ]
            > 
            [ - > > - < < ]
            < < [ - ]
            < < < < <
            + 
            > > >
        ]
    ]
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <

    /* Logic for ']': (Opcode == 93) */
    > 
    [ - > > + < < ] 
    > > 
    +++++++ [ > ++++++ < - ] 
    < 
    ++++++++++++++++++++++++++++++
    ++ 
    [ - > + < ]
    > 
    [ - ] < 
    /* Check if GuestTape[VDP] is non-zero */
    < < 
    [ - > + < ]
    > > 
    > > > 
    < [ - > + < ]
    [
        /* If ZERO: just move to IP increment */
        < < < < < < < <
        > > > > >
        < [ - < + > ]
        < < < <
    ] 
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <
    [
        /* If NON-ZERO: execute Backward Jump logic */
        > > > + < < <
        - 
        > > > [
            < < < 
            > > > [ - > + < ] < < < 
            > > > > > 
            < < < < [ - > + < ] 
            [ - < < < < + > ] 
            < < < < <
            > 
            [ - > > + < < ]
            > > 
            +++++++ [ > ++++++ < - ]
            < 
            ++++++++++++++++++++++++++++++
            ++ 
            [ - > + < ]
            > 
            [ - > + < ]
            > 
            [ - > > + < < ]
            < < [ - ]
            > 
            [ - > > + < < ]
            > > 
            +++++++ [ > ++++++ < - ]
            < 
            ++++++++++++++++++++++++++++++
            [ - > + < ]
            > 
            [ - > + < ]
            > 
            [ - > > - < < ]
            < < [ - ]
            < < < < <
            - 
            > > >
        ]
    ]
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <

    /* --- STEP 3: IP INCREMENT ---
     * Advance the Instruction Pointer for the next cycle.
     */
    + 
]