/*
 * The Self-Referential Loop: Full BF-in-BF Interpreter v2
 * 
 * Memory Map (The Control Hub):
 * [0] : Current Opcode Register
 * [1] : Instruction Pointer (IP)
 * [2] : Virtual Data Pointer (VDP) - Relative offset to Guest Tape Start
 * [3] : Temp / Scratchpad A / Nesting Counter
 * [4] : Temp / Scratchpad B / Search State
 * [5...] : Guest Program and Workspace (SourceBase = 5)
 */

/* Initialization: Set VDP=0, IP=0 */
[ - ]

/* MAIN EXECUTION LOOP */
[
    /* --- STEP 1: INDEXED FETCH ---
     * Move from IP[1] to (SourceBase[5] + IP[1]) and copy value to Opcode[0]
     */
    > [ - > + < ] < < < < <
    > > > > >
    < < < < [ - > + < ]
    [ - < < < < + > ]
    < < < < <
    >
    [ - > + < ]
    <
    
    /* --- STEP 2: DISPATCHER ---
     * Opcode is now at [0]. 
     * ASCII values: '>' : 62, '<' : 60, '+' : 43, '-' : 45, '.' : 46, ',' : 44, '[' : 91, ']' : 93
     */

    /* Logic for '+': (Opcode == 43) */
    > 
    [ - > > + < < ]
    > > 
    +++++++ [ > ++++++ < - ]
    < 
    [ - > + < ]
    > 
    [ - ] < 
    < < 
    [ - > + < ]
    > > 
    > > > 
    < [ - > + < ]
    + 
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <

    /* Logic for '-': (Opcode == 45) */
    > 
    [ - > > + < < ] 
    > > 
    +++++++ [ > ++++++ < - ] 
    < 
    -- 
    [ - > + < ] 
    > 
    [ - ] < 
    < < 
    [ - > + < ]
    > > > > > 
    < [ - > + < ]
    - 
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <

    /* Logic for '>': (Opcode == 62) */
    > 
    [ - > > + < < ] 
    > > 
    +++++++ [ > ++++++ < - ] 
    < 
    +++++++++++++++++++++++++++
    [ - > + < ]
    > 
    [ - ] < 
    < < 
    + 
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <

    /* Logic for '<': (Opcode == 60) */
    > 
    [ - > > + < < ] 
    > > 
    +++++++ [ > ++++++ < - ] 
    < 
    ++++++++++++++++++++++
    [ - > + < ]
    > 
    [ - ] < 
    < < 
    - 
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <

    /* Logic for '.': (Opcode == 46) */
    > 
    [ - > > + < < ] 
    > > 
    +++++++ [ > ++++++ < - ] 
    < 
    +++ 
    [ - > + < ]
    > 
    [ - ] < 
    < < 
    [ - > + < ]
    > > 
    > > > 
    < [ - > + < ]
    . 
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <

    /* Logic for ',': (Opcode == 44) */
    > 
    [ - > > + < < ] 
    > > 
    +++++++ [ > ++++++ < - ] 
    < 
    + 
    [ - > + < ]
    > 
    [ - ] < 
    < < 
    [ - > + < ]
    > > 
    > > > 
    < [ - > + < ]
    , 
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <

    /* Logic for '[': (Opcode == 91) */
    > 
    [ - > > + < < ] 
    > > 
    +++++++ [ > ++++++ < - ] 
    < 
    ++++++++++++++++++++++++++++++
    [ - > + < ]
    > 
    [ - ] < 
    < < 
    [ - > + < ]
    > > 
    > > > 
    < [ - > + < ]
    [
        < < < < < < < <
        > > > > >
        < [ - < + > ]
        < < < <
    ] 
    < < < < < < < <
    > > > > >
    < [ - < + > ]
    < < < <
    [
        > > > + < < <
        + 
        > > > [
            < < < 
            > > > [ - > + < ] < < < 
            > > > > > 
            < < < < [ - > + < ] 
            [ - < < < < + > ] 
            < < < < <
            >
            [ - > > + < < ]
            > > 
            +++++++ [ > ++++++ < - ]
            < 
            ++++++++++++++++++++++++++++++
            [ - > + < ]
            > 
            [ - > + < ]
            > 
            [ - > > + < < ]
            < < [ - ]
            > 
            [ - > > + < < ]
            > > 
            +++++++ [ > ++++++ < - ]
            < 
            [ - ]
            < < <
        ]
    ]
]
